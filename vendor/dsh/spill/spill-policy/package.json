{
  "name": "@se373/spill-policy",
  "description": "Tool-result spill policy for the DeepSeek Harness — replaces oversized plain-text tool results with a retained preview plus a spill-file path (no service API)",
  "version": "0.1.1-rc.2",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./src/invariant.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zAcherttp/se373.git",
    "directory": "vendor/dsh/spill/spill-policy"
  },
  "dependencies": {
    "@se373/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@se373/invariants": "workspace:^",
    "@se373/llm": "workspace:^",
    "@se373/output-retention": "workspace:^",
    "@se373/session": "workspace:^",
    "@se373/spill": "workspace:^",
    "@se373/tools": "workspace:^",
    "@se373/cordis": "workspace:^"
  },
  "devDependencies": {
    "@se373/agent": "workspace:^",
    "@se373/code-runtime-worker-thread": "workspace:^",
    "@se373/invariants": "workspace:^",
    "@se373/llm": "workspace:^",
    "@se373/output-retention": "workspace:^",
    "@se373/session": "workspace:^",
    "@se373/spill": "workspace:^",
    "@se373/tools": "workspace:^",
    "@se373/cordis": "workspace:^"
  }
}
