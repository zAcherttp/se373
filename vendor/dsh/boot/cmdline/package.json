{
  "name": "@se373/cmdline",
  "description": "Immutable command-line handoff from a dsh launcher to any app plugin that injects cmdlineArgs",
  "version": "0.1.1-rc.2",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./src/invariant.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zAcherttp/se373.git",
    "directory": "vendor/dsh/boot/cmdline"
  },
  "peerDependencies": {
    "@se373/cordis-plugin-loader": "workspace:^",
    "@se373/invariants": "workspace:^",
    "@se373/cordis": "workspace:^"
  },
  "devDependencies": {
    "@se373/cordis-plugin-include": "workspace:^",
    "@se373/cordis-plugin-loader": "workspace:^",
    "commander": "^15.0.0",
    "@se373/invariants": "workspace:^",
    "@se373/cordis": "workspace:^"
  }
}
