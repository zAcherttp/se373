{
  "name": "@se373/session-persistence-jsonl",
  "description": "JSONL durable session persistence backend for the DeepSeek Harness",
  "version": "0.1.1-rc.2",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./src/invariant.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zAcherttp/se373.git",
    "directory": "vendor/dsh/session/session-persistence-jsonl"
  },
  "dependencies": {
    "koffi": "^3.1.0",
    "@se373/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@se373/invariants": "workspace:^",
    "@se373/session": "workspace:^",
    "@se373/session-persistence": "workspace:^",
    "@se373/cordis": "workspace:^"
  },
  "devDependencies": {
    "@se373/invariants": "workspace:^",
    "@se373/session": "workspace:^",
    "@se373/session-persistence": "workspace:^",
    "@se373/cordis": "workspace:^"
  }
}
