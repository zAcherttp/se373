{
  "name": "@se373/jobs",
  "description": "Background job registry (ctx.jobs) for the DeepSeek Harness — shared ids, owner isolation, polling, cancellation, and completion listeners for long-running tool work",
  "version": "0.1.1-rc.2",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./src/invariant.ts"
    },
    "./brand": {
      "types": "./lib/types/brand.d.ts",
      "default": "./src/types/brand.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zAcherttp/se373.git",
    "directory": "vendor/dsh/jobs/jobs"
  },
  "peerDependencies": {
    "@se373/agent": "workspace:^",
    "@se373/brand": "workspace:^",
    "@se373/invariants": "workspace:^",
    "@se373/session": "workspace:^",
    "@se373/cordis": "workspace:^"
  },
  "devDependencies": {
    "@se373/agent": "workspace:^",
    "@se373/brand": "workspace:^",
    "@se373/invariants": "workspace:^",
    "@se373/session": "workspace:^",
    "@se373/cordis": "workspace:^"
  }
}
