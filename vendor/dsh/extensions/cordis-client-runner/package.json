{
  "name": "@se373/cordis-client-runner",
  "description": "Browser half of dynamic dual-half plugin packages: event subscription, closure evaluation, guard facade, and loader entries",
  "version": "0.1.1-rc.2",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./src/invariant.ts"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zAcherttp/se373.git",
    "directory": "vendor/dsh/extensions/cordis-client-runner"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "se373": {
    "upstream": {
      "repo": "deepseek-ai/deepseek-harness",
      "rev": "b150a551b8d465e31e418e1b2eaf5e79bbb7d28e",
      "path": "packages/extensions/cordis-client-runner",
      "name": "@deepseek-ai/dsh-cordis-client-runner"
    }
  },
  "peerDependencies": {
    "@se373/cordis-plugin-loader": "workspace:^",
    "@se373/api-remotes": "workspace:^",
    "@se373/client-connection": "workspace:^",
    "@se373/client-modules": "workspace:^",
    "@se373/client-runtime": "workspace:^",
    "@se373/client-ui-theme": "workspace:^",
    "@se373/invariants": "workspace:^",
    "@se373/cordis": "workspace:^"
  },
  "devDependencies": {
    "@se373/cordis-plugin-loader": "workspace:^",
    "@se373/api-remotes": "workspace:^",
    "@se373/client-connection": "workspace:^",
    "@se373/client-modules": "workspace:^",
    "@se373/client-runtime": "workspace:^",
    "@se373/client-ui-theme": "workspace:^",
    "@se373/invariants": "workspace:^",
    "@types/react": "~18.3.1",
    "@se373/cordis": "workspace:^",
    "react": "^18.2.0"
  }
