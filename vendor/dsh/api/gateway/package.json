{
  "name": "@se373/api-gateway",
  "description": "Typert Remote Host dispatcher and Client API endpoint",
  "version": "0.1.1-rc.2",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./src/invariant.ts"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./src/types.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zAcherttp/se373.git",
    "directory": "vendor/dsh/api/gateway"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-typert-registry",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "se373": {
    "upstream": {
      "repo": "deepseek-ai/deepseek-harness",
      "rev": "b150a551b8d465e31e418e1b2eaf5e79bbb7d28e",
      "path": "packages/api/gateway",
      "name": "@deepseek-ai/dsh-api-gateway"
    }
  },
  "dependencies": {
    "@se373/typert-protocol": "workspace:^"
  },
  "peerDependencies": {
    "@se373/client-connection": "workspace:^",
    "@se373/invariants": "workspace:^",
    "@se373/typert-registry": "workspace:^",
    "@se373/cordis": "workspace:^"
  },
  "devDependencies": {
    "@se373/client-connection": "workspace:^",
    "@se373/host-webserver": "workspace:^",
    "@se373/invariants": "workspace:^",
    "@se373/typert-registry": "workspace:^",
    "@se373/cordis": "workspace:^",
    "zod": "^4.4.3"
  }
}
