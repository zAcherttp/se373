{
  "name": "@se373/host-plugin-inventory",
  "description": "Read-only Remote projection of current Cordis Loader plugin state",
  "version": "0.1.1-rc.2",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./src/invariant.ts"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./src/types.ts"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zAcherttp/se373.git",
    "directory": "vendor/dsh/host/plugin-inventory"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "se373": {
    "upstream": {
      "repo": "deepseek-ai/deepseek-harness",
      "rev": "b150a551b8d465e31e418e1b2eaf5e79bbb7d28e",
      "path": "packages/host/plugin-inventory",
      "name": "@deepseek-ai/dsh-host-plugin-inventory"
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@se373/cordis-plugin-loader": "workspace:^",
    "@se373/brand": "workspace:^",
    "@se373/invariants": "workspace:^",
    "@se373/typert-protocol": "workspace:^",
    "@se373/cordis": "workspace:^"
  },
  "devDependencies": {
    "@se373/cordis-plugin-loader": "workspace:^",
    "@se373/brand": "workspace:^",
    "@se373/invariants": "workspace:^",
    "@se373/typert-protocol": "workspace:^",
    "@se373/cordis": "workspace:^"
  }
}
