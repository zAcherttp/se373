{
  "name": "@se373/invariants",
  "description": "Registry service for package-owned DeepSeek Harness runtime invariants",
  "version": "0.1.1-rc.2",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
