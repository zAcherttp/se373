{
  "name": "@se373/typert-generator",
  "description": "TypeScript project analyzer and model-driven Typert artifact generator",
  "version": "0.1.1-rc.2",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./tsdown": {
      "types": "./lib/types/tsdown-plugin.d.ts",
      "default": "./src/tsdown-plugin.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./src/invariant.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zAcherttp/se373.git",
    "directory": "vendor/dsh/typert/generator"
  },
  "se373": {
    "upstream": {
      "repo": "deepseek-ai/deepseek-harness",
      "rev": "b150a551b8d465e31e418e1b2eaf5e79bbb7d28e",
      "path": "packages/typert/generator",
      "name": "@deepseek-ai/dsh-typert-generator"
    }
  },
  "dependencies": {
    "@jridgewell/gen-mapping": "^0.3.13",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@se373/invariants": "workspace:^",
    "@se373/cordis": "workspace:^"
  },
  "devDependencies": {
    "@se373/invariants": "workspace:^",
    "@se373/typert-registry": "workspace:^",
    "@se373/cordis": "workspace:^",
    "zod": "^4.4.3"
  }
}
