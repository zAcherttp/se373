{
  "name": "@se373/fs-observation-policy",
  "description": "File-context policy plugin for the DeepSeek Harness — observed-state, read-before-edit, and version-guarded write/edit added over the ctx.fs provider seam through the fs/* event gate (no service API)",
  "version": "0.1.1-rc.2",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./src/invariant.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zAcherttp/se373.git",
    "directory": "vendor/dsh/fs/fs-observation-policy"
  },
  "peerDependencies": {
    "@se373/fs": "workspace:^",
    "@se373/invariants": "workspace:^",
    "@se373/cordis": "workspace:^"
  },
  "devDependencies": {
    "@se373/fs": "workspace:^",
    "@se373/invariants": "workspace:^",
    "@se373/llm": "workspace:^",
    "@se373/cordis": "workspace:^"
  }
}
