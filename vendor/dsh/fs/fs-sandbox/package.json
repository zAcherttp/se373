{
  "name": "@se373/fs-sandbox",
  "description": "Sandbox-enforcing implementation of the DeepSeek Harness filesystem seam: fences write/edit by the per-call sandbox mode (read-only denies mutation, workspace-write contains it to the workspace + temp roots) while reads pass through",
  "version": "0.1.1-rc.2",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./src/invariant.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zAcherttp/se373.git",
    "directory": "vendor/dsh/fs/fs-sandbox"
  },
  "se373": {
    "upstream": {
      "repo": "deepseek-ai/deepseek-harness",
      "rev": "b150a551b8d465e31e418e1b2eaf5e79bbb7d28e",
      "path": "packages/fs/fs-sandbox",
      "name": "@deepseek-ai/dsh-fs-sandbox"
    }
  },
  "peerDependencies": {
    "@se373/fs": "workspace:^",
    "@se373/fs-local": "workspace:^",
    "@se373/invariants": "workspace:^",
    "@se373/sandbox": "workspace:^",
    "@se373/sandbox-policy": "workspace:^",
    "@se373/cordis": "workspace:^"
  },
  "devDependencies": {
    "@se373/fs": "workspace:^",
    "@se373/fs-local": "workspace:^",
    "@se373/invariants": "workspace:^",
    "@se373/sandbox": "workspace:^",
    "@se373/sandbox-policy": "workspace:^",
    "@se373/cordis": "workspace:^"
  }
}
