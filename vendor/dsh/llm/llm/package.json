{
  "name": "@se373/llm",
  "description": "Provider-neutral LLM service interface for the DeepSeek Harness",
  "version": "0.1.1-rc.2",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./src/invariant.ts"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./src/types/types.ts"
    },
    "./brand": {
      "types": "./lib/types/brand.d.ts",
      "default": "./src/types/brand.ts"
    },
    "./message": {
      "types": "./lib/types/message.d.ts",
      "default": "./src/types/message.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zAcherttp/se373.git",
    "directory": "vendor/dsh/llm/llm"
  },
  "dependencies": {
    "@se373/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@se373/attachment": "workspace:^",
    "@se373/brand": "workspace:^",
    "@se373/invariants": "workspace:^",
    "@se373/timeout": "workspace:^",
    "@se373/cordis": "workspace:^"
  },
  "devDependencies": {
    "@se373/attachment": "workspace:^",
    "@se373/brand": "workspace:^",
    "@se373/invariants": "workspace:^",
    "@se373/timeout": "workspace:^",
    "@se373/cordis": "workspace:^"
  }
}
