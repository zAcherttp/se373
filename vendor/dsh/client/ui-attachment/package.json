    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./src/invariant.ts"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zAcherttp/se373.git",
    "directory": "vendor/dsh/client/ui-attachment"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "se373": {
    "upstream": {
      "repo": "deepseek-ai/deepseek-harness",
      "rev": "b150a551b8d465e31e418e1b2eaf5e79bbb7d28e",
      "path": "packages/client/ui-attachment",
      "name": "@deepseek-ai/dsh-client-ui-attachment"
    }
  },
  "dependencies": {
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@se373/cordis": "workspace:^",
    "@se373/invariants": "workspace:^",
    "@se373/client-runtime": "workspace:^",
    "@se373/client-ui-conversation": "workspace:^",
    "@se373/attachment": "workspace:^"
  },
  "devDependencies": {
    "@se373/cordis": "workspace:^",
    "@se373/invariants": "workspace:^",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@se373/client-runtime": "workspace:^",
    "@se373/client-ui-conversation": "workspace:^",
    "@se373/client-ui-primitives": "workspace:^",
    "@se373/client-ui-slots": "workspace:^",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@se373/attachment": "workspace:^"
  }
