{
  "name": "@se373/client-ui-attachment",
  "description": "Dynamic attachment presentation plugin for conversation input and message-image slots",
  "version": "0.1.1-rc.2",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "lib/types/index.d.ts",
