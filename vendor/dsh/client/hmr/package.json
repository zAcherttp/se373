{
  "name": "@se373/client-hmr",
  "description": "Dev-only hot-reload driver for script-loaded client entries: SSE rebuilt frames → invalidate/prefetch → fiber swap through the vendored Loader entry",
  "version": "0.1.1-rc.2",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./src/invariant.ts"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zAcherttp/se373.git",
    "directory": "vendor/dsh/client/hmr"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "se373": {
    "upstream": {
      "repo": "deepseek-ai/deepseek-harness",
      "rev": "b150a551b8d465e31e418e1b2eaf5e79bbb7d28e",
      "path": "packages/client/hmr",
      "name": "@deepseek-ai/dsh-client-hmr"
    }
  },
  "dependencies": {
    "@se373/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@se373/cordis-plugin-loader": "workspace:^",
    "@se373/client-modules": "workspace:^",
    "@se373/host-webserver": "workspace:^",
    "@se373/invariants": "workspace:^",
    "@se373/cordis": "workspace:^"
  },
  "devDependencies": {
    "@se373/cordis-plugin-loader": "workspace:^",
    "@se373/client-modules": "workspace:^",
    "@se373/host-webserver": "workspace:^",
    "@se373/invariants": "workspace:^",
    "@se373/cordis": "workspace:^"
  }
}
