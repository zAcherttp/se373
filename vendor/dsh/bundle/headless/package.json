{
  "name": "@se373/headless",
  "description": "The dsh one-shot bundle: a direct core Agent/Session runner over dsh-base with no Host, HTTP, or browser layer",
  "version": "0.1.1-rc.2",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./src/startup.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./src/invariant.ts"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zAcherttp/se373.git",
    "directory": "vendor/dsh/bundle/headless"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@se373/cmdline": "workspace:^",
    "@se373/code-runtime-worker-thread": "workspace:^",
    "@se373/schemastery": "workspace:^",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@se373/cordis-plugin-loader": "workspace:^",
    "@se373/agent": "workspace:^",
    "@se373/agent-default-model": "workspace:^",
    "@se373/invariants": "workspace:^",
    "@se373/llm": "workspace:^",
    "@se373/session": "workspace:^",
    "@se373/cordis": "workspace:^"
  },
  "devDependencies": {
    "@se373/cordis-plugin-loader": "workspace:^",
    "@se373/agent": "workspace:^",
    "@se373/agent-default-model": "workspace:^",
    "@se373/invariants": "workspace:^",
    "@se373/llm": "workspace:^",
    "@se373/session": "workspace:^",
    "@se373/cordis": "workspace:^"
  }
}
