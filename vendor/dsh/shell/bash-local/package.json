{
  "name": "@se373/bash-local",
  "description": "Local-subprocess implementation of the DeepSeek Harness bash executor seam",
  "version": "0.1.1-rc.2",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./src/invariant.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zAcherttp/se373.git",
    "directory": "vendor/dsh/shell/bash-local"
  },
  "dependencies": {
    "@se373/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@se373/shell": "workspace:^",
    "@se373/invariants": "workspace:^",
    "@se373/subprocess": "workspace:^",
    "@se373/timeout": "workspace:^",
    "@se373/cordis": "workspace:^",
    "@se373/settings": "workspace:^"
  },
  "devDependencies": {
    "@se373/shell": "workspace:^",
    "@se373/invariants": "workspace:^",
    "@se373/subprocess": "workspace:^",
    "@se373/subprocess-local": "workspace:^",
    "@se373/timeout": "workspace:^",
    "@se373/cordis": "workspace:^",
    "@se373/settings": "workspace:^"
  }
}
