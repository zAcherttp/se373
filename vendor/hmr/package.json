{
  "name": "@se373/cordis-plugin-hmr",
  "description": "Hot Module Replacement Plugin for Cordis",
  "version": "1.0.16",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zAchrttp/se373.git",
    "directory": "vendor/hmr"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "author": "Shigma <shigma10826@gmail.com>",
  "license": "MIT",
  "@se373/cordis": {
    "services": {
      "required": [
        "timer"
      ]
    },
    "description": {
      "en": "Hot Module Replacement",
      "zh": "模块热替换"
    }
  },
  "peerDependencies": {
    "@se373/cordis-plugin-timer": "workspace:^",
    "@se373/cordis": "workspace:^",
    "@se373/cordis-plugin-loader": "workspace:^",
    "@se373/cordis-plugin-include": "workspace:^"
  },
  "dependencies": {
    "@babel/code-frame": "^7.29.0",
    "chokidar": "^4.0.3",
    "@se373/cosmokit": "workspace:^",
    "picomatch": "^4.0.3",
    "@se373/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@types/babel__code-frame": "^7.27.0",
    "@types/picomatch": "^3.0.2",
    "esbuild": "^0.28.1",
    "@se373/cordis-plugin-loader": "workspace:^",
    "@se373/cordis-plugin-include": "workspace:^"
  },
  "private": true
}
