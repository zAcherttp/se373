    { "path": "../../../vendor/dsh/client/runtime" },
    { "path": "../../../vendor/dsh/client/locale" },
    { "path": "../../../vendor/dsh/client/ui-layout" },
    { "path": "../../../vendor/dsh/client/ui-primitives" },
    { "path": "../../../vendor/dsh/client/ui-slots" },
    { "path": "../../../vendor/dsh/runtime-diagnostics/invariants" },
    { "path": "../../runtime/board-gateway" }
  ]
}
