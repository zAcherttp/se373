{
  // Shared compiler settings. NEVER add `include`/`files` here: it would leak
  // into every extending project.
  //
  // There is deliberately no `paths` block. pnpm's isolated workspace links
  // already resolve every `@se373/*` name from the importing package's own
  // node_modules, which means a package that forgets to declare a dependency
  // fails to resolve instead of silently working — the same discipline Cordis
  // wants from `inject`. It also keeps tsc and tsx agreeing on one resolution,
  // rather than tsx applying `paths` at runtime and landing on a .d.ts.
  //
  // Vendored framework packages point `types` at their built lib/types and
  // `default` at src, so their relaxed strictness never enters our program
  // while the runtime still loads source.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  }
}
