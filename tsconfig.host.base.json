{
  // The HOST-FACE compiler shape: every project in `tsconfig.host.json`, ours
  // and upstream's alike. It is named for the face rather than for provenance
  // because a package of ours that joins the host program needs exactly these
  // settings -- the shared source-resolution facade above all, since that is
  // what keeps one nominal identity per class across the program.
  "extends": ["./tsconfig.base.json", "./tsconfig.vendor.paths.json"],
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    // JavaScript is emitted alongside the declarations, even though our host
    // runs from source and never imports it. The browser build needs it: every
    // UI plugin's tsdown config takes its entries from `lib/types/*.js`, which
    // is tsc's output, and a declarations-only program leaves rolldown with
    // nothing to bundle. Upstream emits both for the same reason.
    "composite": true,
    "incremental": true
  }
}
