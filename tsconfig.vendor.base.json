{
  // Vendored code is upstream's, checked upstream. Relaxations mirror dsh's
  // vendor tsconfigs; do not tighten them to match our packages.
  "extends": ["./tsconfig.base.json", "./tsconfig.vendor.paths.json"],
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    // JavaScript is emitted alongside the declarations, even though our host
    // runs from source and never imports it. The browser build needs it: every
    // UI plugin's tsdown config takes its entries from `lib/types/*.js`, which
    // is tsc's output, and a declarations-only program leaves rolldown with
    // nothing to bundle. Upstream emits both for the same reason.
    "composite": true,
    "incremental": true
  }
}
