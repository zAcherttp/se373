{
  // Our code only. Vendored sources never enter this program: `paths` sends
  // every @se373 framework name to its built declarations, which skipLibCheck
  // then skips.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["packages/*/*/src", "packages/*/*/tests", "apps/*/src", "apps/*/tests", "scripts/*.ts"],
  // The browser half is its own program (`tsconfig.client.json` for the
  // packages, `apps/web/tsconfig.json` for the shell). The host and client
  // planes both merge cordis `Context` under the same keys with different
  // services, so one program cannot hold both sides of that merge -- and only
  // the client base carries React JSX and the DOM library.
  "exclude": ["apps/web", "packages/client"]
}
